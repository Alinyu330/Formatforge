{
  "appId": "com.formatforge.app",
  "productName": "FormatForge",
  "publish": [
    {
      "provider": "generic",
      "url": "https://dl.formatforge.asia/update"
    }
  ],
  "directories": {
    "buildResources": "resources",
    "output": "dist"
  },
  "files": [
    "assets/**/*",
    "build/**/*",
    "capacitor.config.*",
    "app/**/*",
    "!app/assets/*.wasm",
    "!app/assets/*.map",
    "!app/**/*.apk",
    "!app/**/*.exe"
  ],
  "afterPack": "./after-pack.js",
  "extraResources": [
    {
      "from": "resources/ffmpeg.exe",
      "to": "ffmpeg.exe"
    }
  ],
  "nsis": {
    "allowElevation": true,
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "win": {
    "target": ["nsis"],
    "icon": "assets/appIcon.ico"
  },
  "mac": {
    "category": "public.app-category.utilities",
    "target": ["dmg"]
  },
  "linux": {
    "target": ["AppImage"],
    "category": "Utility"
  }
}